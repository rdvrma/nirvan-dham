SARVAM_API_KEY=replace-with-server-side-key
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_DAILY_LIMIT=30
# Cloud webhook only: random secret and existing Supabase server key. Never use NEXT_PUBLIC_ for either.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-existing-server-side-supabase-key
TELEGRAM_GLOBAL_DAILY_LIMIT=300
# Optional: absolute path to the private bot state file; keep it outside this repository.
# TELEGRAM_STATE_FILE=C:/Users/pc/AppData/Local/NirvanDham/telegram-bot/state.json
GEMINI_API_KEY=replace-with-server-side-key-for-content-scripts
GEMINI_FILE_SEARCH_STORE=replace-with-uploaded-file-search-store-name
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
SMTP_USER=your-course-notifications@gmail.com
SMTP_APP_PASSWORD=your-google-app-password
ADMIN_EMAIL=your-inbox@example.com
GUARDDOG_SECRET=replace-with-a-long-random-secret-string
NEXT_PUBLIC_BASE_URL=https://nirvandham.in
